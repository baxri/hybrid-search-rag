**/.env
**/.env.*

# Rebuilt or downloaded inside the image.
**/node_modules
frontend/dist
backend/.venv
backend/data

# Not needed at runtime.
.git
.claude
.superpowers
docs
backend/tests
backend/evals
**/__pycache__
**/.pytest_cache
**/.ruff_cache
